{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dryyt-tracker",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-21",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dryyt-tracker-db",
			"database_id": "f6aae4ea-9b19-42fd-b141-d90c0dfbd1fd",
			"migrations_dir": "./migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "AVATARS",
			"bucket_name": "dryyt-tracker-avatars"
		}
	],
	"durable_objects": {
		// Live /track?code= updates (plugins/workflow/backend/TrackRoom.ts).
		// Not inherited by the envs below — each repeats it.
		"bindings": [
			{
				"name": "TRACK_ROOMS",
				"class_name": "TrackRoom"
			}
		]
	},
	// Daily housekeeping at 03:00 UTC — see scheduled() in worker/index.ts.
	"triggers": {
		"crons": ["0 3 * * *"]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["TrackRoom"]
		}
	],
	"vars": {
		"DEV_MODE": "false",
		// Origins allowed to call /api/* cross-origin (comma-separated) — the
		// Vite dev server locally; each env below allows its own custom domain.
		"CORS_ORIGINS": "http://localhost:5173"
	},
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"env": {
		// Staging: separate D1 + R2 so nothing here touches production data.
		// database_id is filled in after `wrangler d1 create dryyt-tracker-staging-db`.
		"staging": {
			"name": "dryyt-tracker-staging",
			"routes": [
				{
					"pattern": "app-demo.dryyt.com",
					"custom_domain": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "dryyt-tracker-staging-db",
					"database_id": "97492910-852e-4fad-ac34-a0fafab0072c",
					"migrations_dir": "./migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "AVATARS",
					"bucket_name": "dryyt-tracker-staging-avatars"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "TRACK_ROOMS",
						"class_name": "TrackRoom"
					}
				]
			},
			"vars": {
				"DEV_MODE": "false",
				"CORS_ORIGINS": "https://app-demo.dryyt.com"
			}
		},
		"production": {
			"name": "dryyt-tracker",
			"routes": [
				{
					"pattern": "app.dryyt.com",
					"custom_domain": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "dryyt-tracker-db",
					"database_id": "f6aae4ea-9b19-42fd-b141-d90c0dfbd1fd",
					"migrations_dir": "./migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "AVATARS",
					"bucket_name": "dryyt-tracker-avatars"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "TRACK_ROOMS",
						"class_name": "TrackRoom"
					}
				]
			},
			"vars": {
				"DEV_MODE": "false",
				"CORS_ORIGINS": "https://app.dryyt.com"
			}
		}
	}
}