{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dryyt-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-21",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dryyt-tracker-db",
      "database_id": "f6aae4ea-9b19-42fd-b141-d90c0dfbd1fd",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "AVATARS", "bucket_name": "dryyt-tracker-avatars" }
  ],
  "vars": {
    "DEV_MODE": "false"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "production": {
      "name": "dryyt-tracker",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dryyt-tracker-db",
          "database_id": "f6aae4ea-9b19-42fd-b141-d90c0dfbd1fd",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "AVATARS", "bucket_name": "dryyt-tracker-avatars" }
      ],
      "vars": {
        "DEV_MODE": "false"
      }
    }
  }
}
